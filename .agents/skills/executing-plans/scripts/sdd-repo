#!/usr/bin/env bash
# Print the top-level git repository path for the current working directory.
# Pass --with-commit to also require at least one commit at HEAD.
set -euo pipefail

repo=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "sdd-repo: not inside a git repository" >&2
  exit 2
}

if [ "${1:-}" = "--with-commit" ]; then
  git -C "$repo" rev-parse --verify --quiet HEAD >/dev/null || {
    echo "sdd-repo: repository at $repo has no commits yet" >&2
    exit 2
  }
fi

printf '%s\n' "$repo"
